<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through Android backup or device-to-device
     transfer: preferences hold the sign-in session, the databases hold health
     data. Logs come back from the cloud after signing in on a new phone.
     (allowBackup="false" alone doesn't stop device transfer on Android 12+.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
