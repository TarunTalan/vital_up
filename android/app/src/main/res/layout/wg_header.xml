<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_header"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView android:id="@+id/wg_title" android:layout_width="0dp" android:layout_height="wrap_content"
    android:fontFamily="@font/sf_pro_rounded_semibold" android:textSize="13dp" android:textColor="@color/wg_text"
    android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
    android:text="Today" android:layout_weight="1"/>
    <TextView android:id="@+id/wg_updated" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:fontFamily="@font/sf_pro_rounded_regular" android:textSize="11dp" android:textColor="@color/wg_text_secondary"
    android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
    android:text="" />
    <ImageView android:id="@+id/wg_refresh" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginStart="2dp" android:padding="4dp" android:src="@drawable/wg_ic_refresh"
        android:tint="@color/wg_text_secondary" android:contentDescription="@string/wg_refresh"/>
    <!-- Shown in place of the refresh icon while a refresh runs. -->
    <ProgressBar android:id="@+id/wg_refresh_progress" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginStart="2dp" android:padding="5dp" android:indeterminate="true"
        android:indeterminateTint="@color/wg_primary" android:visibility="gone"
        style="?android:attr/progressBarStyleSmall"/>
</LinearLayout>
