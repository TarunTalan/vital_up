    android:text="250 ml" android:layout_marginStart="4dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/wg_action3" android:layout_width="0dp" android:layout_height="36dp"
    android:layout_weight="1" android:background="@drawable/wg_btn_soft" android:gravity="center" android:orientation="horizontal"
    android:layout_marginStart="6dp" android:paddingStart="6dp" android:paddingEnd="6dp">
    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/wg_ic_vita" android:tint="@color/wg_primary"
