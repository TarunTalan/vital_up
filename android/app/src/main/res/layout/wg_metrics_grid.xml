<LinearLayout android:id="@+id/wg_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:orientation="horizontal">
<LinearLayout android:id="@+id/wg_action1" android:layout_width="0dp" android:layout_height="36dp"
    android:layout_weight="1" android:background="@drawable/wg_btn_soft" android:gravity="center" android:orientation="horizontal"
    android:layout_marginStart="0dp" android:paddingStart="6dp" android:paddingEnd="6dp">
    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/wg_ic_scan" android:tint="@color/wg_primary"
        android:importantForAccessibility="no"/>
    <TextView android:id="@+id/wg_action1_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:fontFamily="@font/sf_pro_rounded_medium" android:textSize="12dp" android:textColor="@color/wg_primary"
    android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
    android:text="Scan meal" android:layout_marginStart="4dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/wg_action2" android:layout_width="0dp" android:layout_height="36dp"
    android:layout_weight="1" android:background="@drawable/wg_btn_primary" android:gravity="center" android:orientation="horizontal"
