</LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/wg_grid_row2" android:layout_width="match_parent" android:layout_height="0dp"
    android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="horizontal">
<LinearLayout android:id="@+id/wg_slot3" android:layout_width="0dp" android:layout_height="match_parent"
