<?xml version="1.0" encoding="utf-8"?>
<!-- Food Log & Macros Home Screen Widget -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_food_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Food &amp; Macros" android:drawableStart="@drawable/ic_widget_food" android:drawablePadding="6dp"
            android:textColor="@color/widget_calories"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_food_scan_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_scan_food"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <!-- Refresh Button & Spinner -->
        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp">

            <ImageView
                android:id="@+id/widget_food_refresh_btn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_refresh_tooltip"
                android:padding="2dp"
                android:src="@drawable/ic_widget_refresh" />

            <ProgressBar
                android:id="@+id/widget_food_refresh_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Calories Consumed vs Goal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_food_calories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="1,640"
                android:textColor="@color/widget_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_food_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="/ 2,000 kcal"
                android:textColor="@color/widget_secondary_text"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_food_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="360 kcal left"
                android:textColor="@color/widget_calories"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_food_progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="82"
            android:progressDrawable="@drawable/widget_calories_progress" />
    </LinearLayout>

    <!-- 3 Macro Cards: Protein, Carbs, Fat -->
    <LinearLayout
        android:id="@+id/widget_food_macros_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Protein -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Protein"
                android:textColor="@color/widget_protein"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_macro_protein"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="110g"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/widget_macro_protein_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:max="100"
                android:progress="80"
                android:progressDrawable="@drawable/widget_protein_progress" />
        </LinearLayout>

        <!-- Carbs -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Carbs"
                android:textColor="@color/widget_carbs"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_macro_carbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="185g"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/widget_macro_carbs_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:max="100"
                android:progress="74"
                android:progressDrawable="@drawable/widget_carbs_progress" />
        </LinearLayout>

        <!-- Fat -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Fat"
                android:textColor="@color/widget_fat"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_macro_fat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="52g"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/widget_macro_fat_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:max="100"
                android:progress="65"
                android:progressDrawable="@drawable/widget_fat_progress" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
