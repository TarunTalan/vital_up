<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network & Internet (required for Supabase sync, Firebase, Mapbox, ML API) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Merged in by libraries but never used (the camera records no audio,
         files stay in app storage, no ads attribution). A health app asking
         for them raises Play / Health Connect review questions. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!-- Reminders: reschedule after a reboot (flutter_local_notifications). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-sdk tools:overrideLibrary="cachet.plugins.health" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Health Connect, read only. Only types a visible feature shows (Play
         minimum-scope policy): heart rate / HRV / SpO2 / blood pressure were
         removed because nothing on screen displayed them. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- Steps: Home, activity goals, Arena points -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Health Sync: import weight and workouts -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <!-- Bluetooth LE permissions (flutter_blue_plus — heart rate monitor) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:label="VitalUp"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- ML Kit OCR and barcode models come from Google Play Services
             (see build.gradle.kts); download them at install time. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,barcode" />
        <meta-data
            android:name="com.pravera.flutter_foreground_task.NOTIFICATION_ICON"
            android:resource="@mipmap/ic_launcher" />
        <!-- FCM: channel and icon for pushes received while the app is in the
             background (created in PushService). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="vitalup_general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- Health Connect: "why does VitalUp need access" opens the privacy
             policy (Android 13 and lower)... -->
        <activity
            android:name=".PermissionsRationaleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- ...and the same from Android 14+ permission settings. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Reminders: scheduled local notifications, kept across reboots
             and app updates. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Reminder action buttons (e.g. "+250 ml" on water reminders). -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- background_downloader's user-initiated job service (dataSync type).
             Unused: audio downloads run as WorkManager jobs without a
             foreground service, so no extra Play Console declaration. -->
        <service
            android:name="com.bbflight.background_downloader.UIDTJobService"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- vitalup:// links (home screen widgets) are routed by GoRouter
                 (/open?route=...); see HomeWidgetService.routeOf. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Opened from the home screen widget. -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH" />
            </intent-filter>
            <!-- Deep linking for vitalup:// custom scheme -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vitalup" />
            </intent-filter>
        </activity>

        <!-- Home screen widgets, one receiver per size the app offers: Android
             pins a widget at its provider's default size (see WidgetSizes.kt).
             Original class names are kept so placed widgets keep working. -->
        <!-- Redraws the widgets just after midnight (WidgetMidnight.kt). -->
        <receiver android:name=".WidgetMidnightReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".TodaySmallWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_today_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/today_small_widget_info" />
        </receiver>
        <receiver android:name=".VitalUpWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_vital_up">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/vitalup_widget_info" />
        </receiver>
        <receiver android:name=".TodayLargeWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_today_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/today_large_widget_info" />
        </receiver>
        <receiver android:name=".TodayXLargeWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_today_x_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/today_xlarge_widget_info" />
        </receiver>
        <receiver android:name=".CustomSmallWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_custom_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/custom_small_widget_info" />
        </receiver>
        <receiver android:name=".CustomWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_custom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/custom_widget_info" />
        </receiver>
        <receiver android:name=".CustomLargeWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_custom_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/custom_large_widget_info" />
        </receiver>
        <receiver android:name=".CustomXLargeWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_custom_x_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/custom_xlarge_widget_info" />
        </receiver>
        <receiver android:name=".HydrationWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_hydration">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/hydration_widget_info" />
        </receiver>
        <receiver android:name=".WaterWideWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_water_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/water_wide_widget_info" />
        </receiver>
        <receiver android:name=".MoodBarWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_mood_bar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/mood_bar_widget_info" />
        </receiver>
        <receiver android:name=".MoodWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_mood">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/mood_widget_info" />
        </receiver>
        <receiver android:name=".ShortcutsSmallWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_shortcuts_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/shortcuts_small_widget_info" />
        </receiver>
        <receiver android:name=".QuickShortcutsWidgetProvider"
            android:exported="true"
            android:label="@string/wg_label_quick_shortcuts">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/quick_shortcuts_widget_info" />
        </receiver>
        <!-- Widget buttons (add water, mood, refresh) run Dart in the background.
             Only reached by explicit in-app intents (Wg.runInDart), so other
             apps can't log data through it. -->
        <receiver android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.BACKGROUND" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Music apps for the workout audio picker (Android 11+ package
             visibility; MainActivity getInstalledAudioApps / launchAudioApp). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>
</manifest>
