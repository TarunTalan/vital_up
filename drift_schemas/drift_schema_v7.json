    {
      "name": "drift_activity_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drift_activity_sessions\" (\"id\" TEXT NOT NULL, \"activity_type\" TEXT NOT NULL, \"start_time\" INTEGER NOT NULL, \"end_time\" INTEGER NULL, \"total_distance_meters\" REAL NOT NULL, \"total_duration_seconds\" INTEGER NOT NULL, \"avg_pace_seconds_per_km\" INTEGER NOT NULL, \"calories\" INTEGER NOT NULL, \"steps\" INTEGER NOT NULL, \"step_count_reliable\" INTEGER NOT NULL DEFAULT 1 CHECK (\"step_count_reliable\" IN (0, 1)), \"target_type\" TEXT NULL, \"target_value\" REAL NULL, \"target_achieved\" INTEGER NULL DEFAULT 0 CHECK (\"target_achieved\" IN (0, 1)), \"synced\" INTEGER NOT NULL DEFAULT 0 CHECK (\"synced\" IN (0, 1)), \"intensity\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "drift_track_points",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drift_track_points\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" TEXT NOT NULL REFERENCES drift_activity_sessions (id) ON DELETE CASCADE, \"latitude\" REAL NOT NULL, \"longitude\" REAL NOT NULL, \"timestamp\" INTEGER NOT NULL, \"accuracy\" REAL NOT NULL, \"speed\" REAL NOT NULL, \"altitude\" REAL NOT NULL DEFAULT 0.0);"
        }
      ]
    }
