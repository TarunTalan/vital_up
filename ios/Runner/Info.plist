<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>VitalUp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>VitalUp</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<!-- vitalup:// links (notifications, /open?route=) are routed by GoRouter. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.vitalup.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vitalup</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Purpose strings. Each one enables its permission_handler strategy
	     (SPM reads these keys), so keep only what the app asks for. -->
	<key>NSAppleMusicUsageDescription</key>
	<string>VitalUp plays music from your library during workouts.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>VitalUp connects to Bluetooth heart rate straps to show your heart rate during workouts.</string>
	<key>NSCameraUsageDescription</key>
	<string>VitalUp uses the camera to scan food, barcodes and nutrition labels.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>VitalUp uses Face ID to unlock the app when app lock is on.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>VitalUp reads your steps, workouts, weight and sleep from Apple Health to show your progress. VitalUp never writes to Apple Health.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>VitalUp uses your location to map your route and measure distance and pace during walks, runs and rides, and to download maps of your area for offline use.</string>
	<key>NSMotionUsageDescription</key>
	<string>VitalUp uses motion data to count your steps during workouts.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>VitalUp lets you choose a food photo from your library to scan.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- location: a GPS workout keeps recording with the screen locked (While
	     In Use + the blue indicator, never Always). audio: workout music and
	     the voice coach. remote-notification: FCM data messages. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- iPhone only and portrait, like main.dart's setPreferredOrientations. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
